{
  "manifest_version": 3,
  "name": "Privacy-First AI Browser Agent",
  "version": "1.0",
  "description": "Detects and masks sensitive information on webpages.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "Privacy Agent",
    "default_popup": "popup.html"
  }
}